# Environment Configuration for Agent 40 - Fee Management Agent

# Application
ENVIRONMENT=development
APP_NAME=Agent40-FeeManagement
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database Configuration (SQLite default for zero-config local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./agent40.db
# PostgreSQL Example: postgresql+psycopg://user:password@localhost:5432/agent40_db

# Security & JWT
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Audit & Logging
LOG_LEVEL=INFO
AUDIT_LOG_ALL_READS=True

# LLM Providers (Not required for Phase 1; configured for future phases)
GEMINI_API_KEY=
OPENAI_API_KEY=
